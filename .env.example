# Read by the Supabase CLI for supabase/config.toml env() substitutions
# (local `supabase start` only — the hosted project's OAuth creds are set
# directly in the dashboard, this file doesn't affect the live project).
# Optional: only needed to test "Sign in with Google" against local Supabase.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
