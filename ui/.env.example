# Copy to .env and fill in. All EXPO_PUBLIC_* vars are bundled into the client —
# safe by design (anon key relies on RLS), never put the service-role key here.

# Local default (ui/.env is checked in with these same values — real device/store
# builds pull from ui/.env.production instead, forced by Expo's production mode).
# Run `supabase start` and copy PUBLISHABLE_KEY/API_URL from its output — the key
# is derived per-project, not a fixed demo value despite what older docs suggest.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Blank = Sentry disabled locally.
EXPO_PUBLIC_SENTRY_DSN=

# iOS map + Places search need this (docs/map-plan.md §4) — restricted to iOS bundle
# com.smashio.app in Google Cloud Console, with Maps SDK for iOS + Places API enabled.
# Android has no build yet and is NOT covered by this key — don't loosen it to cover
# Android; provision a second, Android-restricted key at Play Store time instead. Blank =
# both platforms render blank grey map tiles and empty Places results.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set in .env.local (gitignored), not here. When present, __DEV__ builds auto sign-in
# on launch instead of showing the login form — lets Maestro skip typing credentials,
# which is what was hitting Maestro #2718 (~10s/keystroke on API 36+ emulators).
# Never set these in a release build's env.
EXPO_PUBLIC_E2E_EMAIL=
EXPO_PUBLIC_E2E_PASSWORD=
