# Copy to .env and fill in. All EXPO_PUBLIC_* vars are bundled into the client —
# safe by design (anon key relies on RLS), never put the service-role key here.

# Point at a real Supabase project once one exists (Project Settings > API).
# Defaults below are the `supabase start` local-dev values (same anon key on
# every machine — see https://supabase.com/docs/guides/local-development).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3Njk2MDAsImV4cCI6MTc5OTUzNjAwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Blank = Sentry disabled locally.
EXPO_PUBLIC_SENTRY_DSN=
