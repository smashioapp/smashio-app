# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
google-service-account.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — EXPO_PUBLIC_* vars are safe to bundle but keep local
# overrides out of git so prod project values never land in a commit
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# design-sync (claude.ai/design) — staged converter + regenerated output,
# never committed. .design-sync/config.json, NOTES.md, conventions.md,
# previews/, overrides/ ARE committed (the durable set).
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
