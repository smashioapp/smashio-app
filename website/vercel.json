{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://unpkg.com https://us.i.posthog.com https://ajbsvsfwjfeofvjuhzrw.supabase.co https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/game/:id", "destination": "/api/game/:id" },
    { "source": "/venue/:slug", "destination": "/api/venue/:slug" },
    { "source": "/club/:slug", "destination": "/api/club/:slug" },
    { "source": "/post/:id", "destination": "/api/post/:id" },
    { "source": "/player/:id", "destination": "/api/player/:id" },
    { "source": "/guides/:slug", "destination": "/api/guides/:slug" },
    { "source": "/badminton-near-me", "destination": "/api/near-me" },
    { "source": "/sydney/:suburb*", "destination": "/api/sydney/:suburb*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
