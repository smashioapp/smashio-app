{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/game/:id", "destination": "/api/game/:id" },
    { "source": "/venue/:id", "destination": "/venue.html" },
    { "source": "/player/:id", "destination": "/player.html" }
  ]
}
