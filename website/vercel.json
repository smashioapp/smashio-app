{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/game/:id", "destination": "/api/game/:id" },
    { "source": "/venue/:slug", "destination": "/api/venue/:slug" },
    { "source": "/club/:slug", "destination": "/api/club/:slug" },
    { "source": "/sydney", "destination": "/api/sydney" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/player/:id", "destination": "/player.html" }
  ]
}
